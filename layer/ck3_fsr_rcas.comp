#version 450
// FSR 1 RCAS sharpening, using AMD's MIT-licensed headers in ffx_fsr1/. Alpha passes through untouched,
// because portrait alpha is the character's silhouette.
// Rebuild: glslangValidator -V --vn kRcasSpv layer\ck3_fsr_rcas.comp -o layer\ck3_fsr_rcas.spv.h
#extension GL_GOOGLE_include_directive : require
#define A_GPU 1
#define A_GLSL 1
#define FSR_RCAS_F 1
#include "ffx_fsr1/ffx_a.h"

layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0) uniform sampler2D inputColor;
layout(set = 0, binding = 1, rgba8) writeonly uniform image2D outputColor;
layout(push_constant) uniform Constants { uvec4 con0; uvec4 size; } c;

AF4 FsrRcasLoadF(ASU2 p) { return texelFetch(inputColor, ivec2(p), 0); }
void FsrRcasInputF(inout AF1 r, inout AF1 g, inout AF1 b) {}

#include "ffx_fsr1/ffx_fsr1.h"

void main()
{
    const uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= c.size.x || pixel.y >= c.size.y) return;
    AF3 color;
    FsrRcasF(color.r, color.g, color.b, pixel, c.con0);
    imageStore(outputColor, ivec2(pixel), vec4(color, texelFetch(inputColor, ivec2(pixel), 0).a));
}
