#version 450
// A correctness check for generic Vulkan compute, not an FSR implementation.
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) buffer Data { uint words[]; } data;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < data.words.length())
        data.words[i] = (data.words[i] ^ 0x5a39c7e1u) + i;
}
